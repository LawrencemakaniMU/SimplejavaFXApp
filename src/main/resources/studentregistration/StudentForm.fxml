<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="studentregistration.StudentController"
            stylesheets="@style.css" prefWidth="620" prefHeight="540">

    <top>
        <Label text="Student Registration" styleClass="title" maxWidth="Infinity">
            <padding><Insets top="16" right="20" bottom="8" left="20"/></padding>
        </Label>
    </top>

    <center>
        <VBox spacing="12">
            <padding><Insets top="8" right="20" bottom="8" left="20"/></padding>

            <GridPane hgap="12" vgap="10">
                <columnConstraints>
                    <ColumnConstraints minWidth="90"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <Label text="Full name:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="nameField" promptText="e.g. Mary Banda"
                           GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Program:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <ComboBox fx:id="programBox" promptText="Choose a program" maxWidth="Infinity"
                          GridPane.rowIndex="1" GridPane.columnIndex="1"/>
            </GridPane>

            <!-- Buttons side by side -->
            <HBox spacing="10">
                <Button fx:id="saveButton" text="Save" defaultButton="true" onAction="#handleSave"/>
                <Button text="Clear" onAction="#handleClear"/>
            </HBox>

            <Label fx:id="messageLabel" wrapText="true" minHeight="20"/>

            <TableView fx:id="studentTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="nameColumn" text="Name" prefWidth="280"/>
                    <TableColumn fx:id="programColumn" text="Program" prefWidth="280"/>
                </columns>
                <placeholder>
                    <Label text="No students registered yet."/>
                </placeholder>
            </TableView>
        </VBox>
    </center>

    <bottom>
        <Label fx:id="countLabel" styleClass="count">
            <padding><Insets top="6" right="20" bottom="12" left="20"/></padding>
        </Label>
    </bottom>
</BorderPane>
